{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "workload", "service", "tests"],
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage"],
      "properties": {"stage": {"enum": ["pilot", "production"]}}
    },
    "workload": {"$ref": "#/definitions/workload"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "containerPort"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "credentialSecret", "credentialKey", "hookEvent", "deletePolicy", "activeDeadlineSeconds", "backoffLimit", "restartPolicy", "hooks"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "credentialSecret": {"type": "string", "minLength": 1},
        "credentialKey": {"type": "string", "minLength": 1},
        "hookEvent": {"const": "test"},
        "deletePolicy": {"type": "array", "items": {"enum": ["before-hook-creation", "hook-succeeded"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "backoffLimit": {"const": 0},
        "restartPolicy": {"const": "Never"},
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hookId", "jobSuffix", "weight", "path", "expectedStatus", "requiresToken"],
            "properties": {
              "hookId": {"type": "string", "minLength": 1},
              "jobSuffix": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "weight": {"type": "integer"},
              "path": {"type": "string", "pattern": "^/"},
              "expectedStatus": {"type": "integer", "minimum": 100, "maximum": 599},
              "requiresToken": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {"image": {"$ref": "#/definitions/image"}}
    }
  }
}
